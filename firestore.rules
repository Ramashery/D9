rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Контент сайта: читать может любой (нужно генератору без ключей), писать — только через консоль/сервисный аккаунт
    match /site/{doc}     { allow read: if true; allow write: if false; }
    match /sections/{doc} { allow read: if true; allow write: if false; }

    // Заявки с формы: только создание, строго по схеме, читать нельзя
    match /leads/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(
                         ['name','email','company','role','service','message','page','createdAt'])
                    && request.resource.data.name is string    && request.resource.data.name.size()    <= 300
                    && request.resource.data.email is string   && request.resource.data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
                    && request.resource.data.message is string && request.resource.data.message.size() > 0
                    && request.resource.data.message.size()    <= 4000
                    && request.resource.data.createdAt is timestamp;
    }
  }
}
